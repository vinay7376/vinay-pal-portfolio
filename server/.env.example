# Server Configuration
PORT=5051
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Connection
# For local MongoDB: mongodb://127.0.0.1:27017/vinay_pal_portfolio
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/vinay_pal_portfolio?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/vinay_pal_portfolio

# Rate Limiting
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=100
CONTACT_RATE_LIMIT_MAX=5

# Optional: Email Notification Transport (Nodemailer)
# If provided, a copy of contact messages will be dispatched to this email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
NOTIFICATION_EMAIL=vphandia7376@gmail.com
